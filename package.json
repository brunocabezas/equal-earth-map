{
  "name": "equal-earth-map",
  "private": true,
  "description": "Interactive Equal Earth world atlas",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "build": "node scripts/copy-vendor.mjs && tsc",
    "check": "tsc --noEmit",
    "serve": "node scripts/copy-vendor.mjs && tsc && python3 -m http.server 8777"
  },
  "dependencies": {
    "d3": "7.9.0",
    "topojson-client": "3.1.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/geojson": "7946.0.16",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.9.2"
  }
}
